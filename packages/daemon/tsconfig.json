  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Inside dist, so that deleting the output also discards the build state that describes it.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../catalog" },
    { "path": "../core" },
    { "path": "../executor-tmux" },
    { "path": "../hooks" },
    { "path": "../ledger" },
    { "path": "../registry" },
    { "path": "../sync" }
  ]
}
