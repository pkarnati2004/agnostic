<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions for the app and its helpers. No App Sandbox: it would block tmux and worktrees. -->
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript to machine code at run time, in the window and in agnd under ELECTRON_RUN_AS_NODE. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- V8 and WebAssembly also write code into memory not allocated with MAP_JIT. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- agnd loads better-sqlite3 and node-pty from Resources/app/node_modules; library validation refuses
       a native module whose signature is not the app's, under a Developer ID and the ad-hoc build. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
