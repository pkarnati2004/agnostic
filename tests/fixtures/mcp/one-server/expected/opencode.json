{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "db": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@acme/db-mcp"
      ],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}",
        "LOG_LEVEL": "info"
      },
      "enabled": true
    },
    "docs": {
      "type": "remote",
      "url": "https://mcp.example.com/docs",
      "headers": {
        "Authorization": "{env:MCP_AUTH}"
      },
      "enabled": true
    }
  }
}
