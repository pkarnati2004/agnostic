{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "sh '<post.sh>' copilot 'SessionStart'; printf '%s\\n' '{}'",
        "timeoutSec": 5
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "bash": "sh '<post.sh>' copilot 'SessionEnd'; printf '%s\\n' '{}'",
        "timeoutSec": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "bash": "sh '<post.sh>' copilot 'UserPromptSubmit'; printf '%s\\n' '{}'",
        "timeoutSec": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "bash": "sh '<post.sh>' copilot 'PreToolUse'; printf '%s\\n' '{}'",
        "timeoutSec": 5
      }
