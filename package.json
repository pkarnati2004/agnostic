{
  "name": "agnostic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && chmod +x packages/cli/dist/main.js && pnpm --filter @agnostic/ui build",
    "test": "vitest run",
    "lint": "biome check . && tsc -b && pnpm --filter @agnostic/ui typecheck && knip && tsx scripts/check-file-size.ts",
    "smoke": "bash scripts/smoke.sh",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:daemon": "tsx --conditions development packages/daemon/src/main.ts run",
    "dev:ui": "pnpm --filter @agnostic/ui dev",
    "agn": "tsx --conditions development packages/cli/src/main.ts",
    "ui:preview": "tsx --conditions development packages/daemon/src/preview-daemon.ts"
  },
  "devDependencies": {
    "@agnostic/core": "workspace:*",
    "@biomejs/biome": "2.5.12",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "@types/ws": "8.18.1",
    "knip": "5.88.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
