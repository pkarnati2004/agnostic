{
  "name": "agnostic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome check . && tsc -b && knip && tsx scripts/check-file-size.ts",
    "smoke": "bash scripts/smoke.sh",
    "dev": "tsx packages/daemon/src/main.ts run",
    "agn": "node -e \"console.error('pnpm agn lands in a later chunk'); process.exit(1)\""
  },
  "devDependencies": {
    "@agnostic/core": "workspace:*",
    "@biomejs/biome": "2.5.12",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "knip": "5.88.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
